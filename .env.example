# 로컬 네이버 로그인에 필요한 설정입니다. 이 파일을 .env로 복사해 값을 입력하세요.
# 프론트엔드 .env의 VITE_NAVER_CLIENT_ID와 동일한 Client ID를 입력합니다.
# KEY=value 형식으로, 따옴표와 export 없이 작성하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:7001/api/auth/callback/naver

# 매일 오전 6시(Asia/Seoul) 정책 이메일 알림. SMTP 입력 후 true로 변경합니다.
POLICY_REMINDER_ENABLED=false
# Gmail 발신 → 로그인 계정의 이메일(네이버 등)로 수신
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# 메일을 보내는 Google 계정의 전체 이메일 주소
MANAGER_EMAIL=
# Google 일반 로그인 비밀번호가 아닌 앱 비밀번호(표시용 공백 없이 입력)
MANAGER_PASSWORD=
# 기본값은 587 / STARTTLS입니다. 기존 SSL 설정이 있다면 아래 값으로 맞추세요.
SMTP_SSL_ENABLED=false
SMTP_STARTTLS_ENABLED=true
# 465 포트를 사용하려면 SSL=true, STARTTLS=false로 함께 변경하세요.
FRONTEND_URL=http://localhost:7001

# GPU 정책 비서 연결 (다른 비서는 local 프로필의 예시 서버 유지)
# 실제 .env에는 GPU serve_policy.py와 동일한 내부 키를 입력합니다.
AI_INTERNAL_KEY=
AI_POLICY_MOCK_ENABLED=false
# Cursor Ports에서 GPU 50051이 Mac [::1]:50051로 전달되는 경우
AI_POLICY_HOST=::1
AI_POLICY_PORT=50051
AI_GRPC_DEADLINE=90s
