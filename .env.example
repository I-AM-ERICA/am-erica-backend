# 기본값 그대로 실행하면 외부 서비스 없이 개발용 체험 API가 동작합니다.
LLM_PROVIDER=demo
AUTH_MODE=local
PERSIST_HISTORY=false
CORS_ORIGINS=["http://localhost:7001","http://127.0.0.1:7001","http://localhost:7000","http://127.0.0.1:7000"]

# HyperCLOVA X 사용 시 LLM_PROVIDER=hyperclova
CLOVA_API_KEY=
CLOVA_MODEL=HCX-005
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com

# 다른 OpenAI 호환 서버 사용 시 LLM_PROVIDER=compatible
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=

# AUTH_MODE=supabase 시 Supabase access token을 검증합니다.
# PERSIST_HISTORY=true 시 아래 SQL 적용 후 사용자별 작업 내역을 저장합니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 실제 검토한 정책 문서 JSON 파일. 기본 파일은 비어 있습니다.
POLICY_DOCUMENTS_PATH=data/policies.json
