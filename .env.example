# prod 프로필에서 사용합니다. 값은 openssl rand -hex 32 등으로 생성하세요.
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=change-me-to-at-least-32-bytes-random-secret
AI_INTERNAL_KEY=change-me-internal-key

DB_URL=jdbc:postgresql://localhost:5432/america
DB_USERNAME=america
DB_PASSWORD=change-me

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Python AI 서버의 4개 gRPC 비서 주소
AI_POLICY_HOST=localhost
AI_POLICY_PORT=50051
AI_PROMOTION_HOST=localhost
AI_PROMOTION_PORT=50052
AI_CUSTOMER_HOST=localhost
AI_CUSTOMER_PORT=50053
AI_MANAGEMENT_HOST=localhost
AI_MANAGEMENT_PORT=50054
AI_GRPC_TLS=false
