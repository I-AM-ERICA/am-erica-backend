# 로컬 네이버 로그인에 필요한 설정입니다. 이 파일을 .env로 복사해 값을 입력하세요.
# 프론트엔드 .env의 VITE_NAVER_CLIENT_ID와 동일한 Client ID를 입력합니다.
# KEY=value 형식으로, 따옴표와 export 없이 작성하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:7001/api/auth/callback/naver

# 매일 오전 6시(Asia/Seoul) 정책 이메일 알림. SMTP 입력 후 true로 변경합니다.
POLICY_REMINDER_ENABLED=false
# Gmail 발신 → 로그인 계정의 이메일(네이버 등)로 수신
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# 메일을 보내는 Google 계정의 전체 이메일 주소
MANAGER_EMAIL=
# Google 일반 로그인 비밀번호가 아닌 앱 비밀번호(표시용 공백 없이 입력)
MANAGER_PASSWORD=
# 기본값은 587 / STARTTLS입니다. 기존 SSL 설정이 있다면 아래 값으로 맞추세요.
SMTP_SSL_ENABLED=false
SMTP_STARTTLS_ENABLED=true
# 465 포트를 사용하려면 SSL=true, STARTTLS=false로 함께 변경하세요.
FRONTEND_URL=http://localhost:7001

# GPU 정책 비서 연결 (다른 비서는 local 프로필의 예시 서버 유지)
# 실제 .env에는 GPU serve_policy.py와 동일한 내부 키를 입력합니다.
AI_INTERNAL_KEY=
AI_POLICY_MOCK_ENABLED=false
# SSH 터널: 로컬 55051 → GPU 50051. .env.policy-mvp의 서버 제공 설정이 우선합니다.
AI_POLICY_HOST=127.0.0.1
AI_POLICY_PORT=55051
AI_POLICY_TLS=false
AI_GRPC_DEADLINE=90s

# Supabase DB에 계정/매장/비서 선택을 계속 저장할 때 사용합니다.
# 먼저 SQL Editor에서 database/supabase-bootstrap.sql을 신규 앱 DB에 1회 실행하세요.
# 연결 준비 전에는 local을 유지하고, 실제 모델 + DB 연결 시 local,policy-mvp,supabase로 바꾸세요.
SPRING_PROFILES_ACTIVE=local
# Connect → Direct → Session pooler의 Host/Port를 사용합니다. URI 전체를 그대로 넣지 않습니다.
# 예: jdbc:postgresql://접속창의호스트:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.iyfmiswfprjohqoffugb
# 프로젝트 DB 비밀번호 (API key가 아닙니다)
DB_PASSWORD=
# openssl rand -hex 32 로 생성한 값을 넣고 고정하여 사용합니다.
# JWT_SECRET=
