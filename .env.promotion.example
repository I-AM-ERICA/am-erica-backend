# Merge these entries into the backend .env. Do not replace existing DB/JWT/Naver/policy settings.
AI_PROMOTION_AUTOSTART=true
AI_PROMOTION_PORT=50152
AI_PROMOTION_DIR=../Promotion-AI
# Optional: CLOVA key in backend .env takes precedence over Promotion-AI/.env.
# CLOVA_STUDIO_API_KEY=your-clova-key
# Optional: prepared Python 3.12 virtualenv, default is ~/.local/share/Promotion-AI/venv-py3.12/bin/python
# AI_PROMOTION_PYTHON=/absolute/path/to/venv/bin/python
# AI_PROMOTION_HTTP_PORT=8081
# POSTER_PUBLIC_BASE_URL=http://127.0.0.1:8081
# AI_PROMOTION_DEMO=false
# AI_PROMOTION_NO_CUTOUT=false
